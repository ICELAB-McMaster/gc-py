; gripper_offset_trials_z111: 3 offsets x 3 = 9 trials, blocked order
; centre X 69.5, Y 178.2; offsets [0.0, 15.0, 30.0] -> X 69.5, 84.5, 99.5
; Z approach 90, grip 111, release 100 (+Z is DOWN)
; WARNING the release is 11 mm ABOVE the grip, so the plate FALLS 11 mm every trial. Declared deliberately.
; data -> ~/gripper_captures/offsets_z111_<stamp>_plate.csv and _pcb.csv on the Pi, joined on wall_clock, copied to the NAS
; PREFLIGHT - if any line below reports 'Unknown command', STOP: gripper_macros.cfg is not included from printer.cfg and nothing in this file will actually grip. If the version printed is older than you expect, the INSTALLED copy has drifted from the repo. See docs/LAB.md.
M400 
GRIPPER_MACROS_VERSION
G4 P1500
M400 
GRIPPER_PING
G4 P1500
M400 
GRIPPER_STATUS
G4 P1500
G28 Z
G28 X Y
G0 F6000 Z5
M400 
M400 
GRIPPER_TRIALS_BEGIN NAME=offsets_z111 RATE=50 CENTRE_X=69.5 OFFSETS=0,15,30 TRIALS=3 TRIALS_TOTAL=9 APPROACH_Z=90 GRIP_Z=111 RELEASE_Z=100 MA=500 HOLD=1 RANDOMISE=0 BOARD_INTERVAL_MS=20
G4 P1500
; --- trial 1 of 9: offset +0 mm, X 69.5 ---
M400 
GRIPPER_TRIAL TRIAL=0 RUN_ORDER=0 OFFSET=0 X=69.5 RANDOMISED=0
M400 
GRIPPER_TRIAL_PHASE PHASE=traverse X=69.5 Z=90
G0 F6000 X69.5 Y0 Z5
G0 F6000 X69.5 Y178.2 Z5
G0 F6000 Z90
M400 
GRIPPER_TRIAL_HOME
G4 P1500
M400 
GRIPPER_OPEN
G4 P1500
M400 
GRIPPER_TRIAL_PHASE PHASE=descend Z=111
G0 F6000 Z111
M400 
GRIPPER_TRIAL_BURST INSTANT=before_grip SAMPLES=25 INTERVAL_MS=20 SETTLE=0.4 PHASE=settle
G4 P2400
M400 
GRIPPER_TRIAL_GRIP MA=500
G4 P2000
M400 
GRIPPER_TRIAL_PHASE PHASE=lifting Z=90
G0 F6000 Z90
M400 
GRIPPER_TRIAL_BURST INSTANT=raised SAMPLES=25 INTERVAL_MS=20 SETTLE=0.3 PHASE=raised
G4 P2300
G4 P1000
M400 
GRIPPER_TRIAL_PHASE PHASE=lowering Z=100
G0 F6000 Z100
M400 
GRIPPER_TRIAL_BURST INSTANT=lowered SAMPLES=25 INTERVAL_MS=20 SETTLE=0.3
G4 P2300
M400 
GRIPPER_TRIAL_RELEASE
G4 P1500
G4 P1000
M400 
GRIPPER_TRIAL_PHASE PHASE=retract Z=90
G0 F6000 Z90
