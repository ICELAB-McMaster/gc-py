; gripper_offset_trials_z112.5: 3 offsets x 5 = 15 trials, randomised, seed 12345
; centre X 69.5, Y 178.4; offsets [0.0, -20.0, -40.0] -> X 69.5, 49.5, 29.5
; Z approach 90, grip 112.5, release 100 (+Z is DOWN)
; WARNING the release is 12.5 mm ABOVE the grip, so the plate FALLS 12.5 mm every trial. Declared deliberately.
; data -> ~/gripper_captures/offsets_z112.5_<stamp>_plate.csv and _pcb.csv on the Pi, joined on wall_clock, copied to the NAS
; PREFLIGHT - if any line below reports 'Unknown command', STOP: gripper_macros.cfg is not included from printer.cfg and nothing in this file will actually grip. If the version printed is older than you expect, the INSTALLED copy has drifted from the repo. See docs/LAB.md.
M400 
GRIPPER_MACROS_VERSION
G4 P1500
M400 
GRIPPER_PING
G4 P1500
M400 
GRIPPER_STATUS
G4 P1500
G28 Z
G28 X Y
G0 F6000 Z5
M400 
M400 
GRIPPER_TRIALS_BEGIN NAME=offsets_z112.5 RATE=50 CENTRE_X=69.5 OFFSETS=0,-20,-40 TRIALS=5 TRIALS_TOTAL=15 APPROACH_Z=90 GRIP_Z=112.5 RELEASE_Z=100 MA=500 HOLD=1 RANDOMISE=1 BOARD_INTERVAL_MS=20 SEED=12345
G4 P1500
; --- trial 1 of 15: offset -40 mm, X 29.5 ---
M400 
GRIPPER_TRIAL TRIAL=0 RUN_ORDER=0 OFFSET=-40 X=29.5 RANDOMISED=1 SEED=12345
M400 
GRIPPER_TRIAL_PHASE PHASE=traverse X=29.5 Z=90
G0 F6000 X29.5 Y0 Z5
G0 F6000 X29.5 Y178.4 Z5
G0 F6000 Z90
M400 
GRIPPER_TRIAL_HOME
G4 P1500
M400 
GRIPPER_OPEN
G4 P1500
M400 
GRIPPER_TRIAL_PHASE PHASE=descend Z=112.5
G0 F6000 Z112.5
M400 
GRIPPER_TRIAL_BURST INSTANT=before_grip SAMPLES=25 INTERVAL_MS=20 SETTLE=0.4 PHASE=settle
G4 P2400
M400 
GRIPPER_TRIAL_GRIP MA=500
G4 P2000
M400 
GRIPPER_TRIAL_PHASE PHASE=lifting Z=90
G0 F6000 Z90
M400 
GRIPPER_TRIAL_BURST INSTANT=raised SAMPLES=25 INTERVAL_MS=20 SETTLE=0.3 PHASE=raised
G4 P2300
G4 P1000
M400 
GRIPPER_TRIAL_PHASE PHASE=lowering Z=100
G0 F6000 Z100
M400 
GRIPPER_TRIAL_BURST INSTANT=lowered SAMPLES=25 INTERVAL_MS=20 SETTLE=0.3
G4 P2300
M400 
GRIPPER_TRIAL_RELEASE
G4 P1500
G4 P1000
M400 
GRIPPER_TRIAL_PHASE PHASE=retract Z=90
G0 F6000 Z90
